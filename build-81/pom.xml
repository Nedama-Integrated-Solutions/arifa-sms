<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nedama.arifa</groupId>
        <artifactId>arifa-parent</artifactId>
        <version>0.9.0</version>
    </parent>

    <artifactId>arifa-build-81</artifactId>
    <packaging>pom</packaging>

    <name>Arifa Module Build (Ignition 8.1)</name>
    <description>Packages arifa-gateway-81 and arifa-core into the signed-or-unsigned .modl file.</description>

    <properties>
        <module-name>Arifa SMS Notification</module-name>
        <module-description>Sends alarm notifications as SMS through Kenyan providers, starting with Africa's Talking.</module-description>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.nedama.arifa</groupId>
            <artifactId>arifa-gateway-81</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nedama.arifa</groupId>
            <artifactId>arifa-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.inductiveautomation.ignitionsdk</groupId>
                <artifactId>ignition-maven-plugin</artifactId>
                <version>1.1.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>modl</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <!-- Each name below must equal that project's Maven <name>, which is set to its artifactId.
                         If they differ, the plugin logs ignitionScope=null and builds a module with no jars in it. -->
                    <projectScopes>
                        <projectScope>
                            <name>arifa-gateway-81</name>
                            <scope>G</scope>
                        </projectScope>
                        <projectScope>
                            <name>arifa-core</name>
                            <scope>G</scope>
                        </projectScope>
                    </projectScopes>

                    <!-- Never change the module ID after the first client install. -->
                    <moduleId>com.nedama.ignition.arifa</moduleId>
                    <moduleName>${module-name}</moduleName>
                    <moduleDescription>${module-description}</moduleDescription>
                    <moduleVersion>${project.version}</moduleVersion>
                    <requiredIgnitionVersion>${arifa.required-ignition-version}</requiredIgnitionVersion>
                    <licenseFile>license.html</licenseFile>

                    <depends>
                        <depend>
                            <scope>G</scope>
                            <moduleId>com.inductiveautomation.alarm-notification</moduleId>
                        </depend>
                    </depends>

                    <hooks>
                        <hook>
                            <scope>G</scope>
                            <hookClass>com.nedama.arifa.gateway81.ArifaGatewayHook</hookClass>
                        </hook>
                    </hooks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
